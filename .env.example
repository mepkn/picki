# ---------------------------------------------------------------------------
# backend/.env.local — written for you by `npx convex dev` (local deployment);
# the web app reads it too
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# Production deploy (git-ignored, read by scripts/deploy.sh)
# ---------------------------------------------------------------------------
# backend/.env.prod.local
# CONVEX_DEPLOY_KEY=prod:<production deploy key>
#
# web/.env.prod.local
# DEPLOY_HOST=user@your-server
# DEPLOY_PORT=22
# DEPLOY_DIR=/var/www/picki

# ---------------------------------------------------------------------------
# Convex deployment env (set with `npx convex env set`, not in a file)
# ---------------------------------------------------------------------------
# JWT_PRIVATE_KEY / JWKS   npm run setup:auth in backend/ (add --prod for production)
# SITE_URL=http://localhost:5173
# ALLOWED_EMAILS=you@example.com
